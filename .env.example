# Optional: Meta (Facebook) Pixel ID, used to fire PageView + Lead events
# for ad conversion tracking. Leave empty to disable the pixel.
NEXT_PUBLIC_META_PIXEL_ID=

# Optional: a webhook URL (Zapier / Make / n8n / Telegram bot / your CRM)
# that receives every submitted lead as a JSON POST: { name, phone, consent,
# source, locale, landingPain, city, timeframe, selectedPain,
# qualified, page, userAgent, createdAt }.
# If unset, leads are only printed to the server console — set this before
# sending real ad traffic so you don't lose leads.
LEAD_WEBHOOK_URL=

# Required before going live: the booking link for the free 15-minute call,
# shown to visitors the quiz marks as "qualified". Create this in
# Google Calendar → Settings → Appointment schedules → set up a schedule →
# copy the "Booking page link". Until this is set, a non-functional
# placeholder URL is used.
NEXT_PUBLIC_BOOKING_URL=

# Required for the homepage "Прежде чем сдать ключи" article cards and the
# /[locale]/blog/[slug] article pages: a DatoCMS Content Delivery API
# (read-only) token, from Project settings → API tokens in the DatoCMS
# admin. Without it, no articles are fetched and the section renders no
# article cards (fails soft, doesn't break the build).
DATOCMS_API_TOKEN=
